@page
@model shopassistantweb.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin Settlement & Ledger Dashboard";
}

<div class="py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">&#128202; Admin Settlement &amp; General Ledger Console</h1>
            <p class="text-secondary mb-0">Reconcile processor settlement batches, clear receivables to cash, and inspect GL journals.</p>
        </div>
        <div>
            <span class="badge bg-light text-dark border p-2">
                &#9989; <code>ReceiveSettlementUseCase</code> Active
            </span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <strong>Success!</strong> @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <strong>Error:</strong> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Settlement Batch Processing Section -->
    <div class="card border-0 shadow-sm mb-4 border-start border-success border-4">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <h5 class="fw-bold mb-1">&#128181; Processor Bank Settlement Batch</h5>
                    <p class="text-secondary small mb-2">
                        Move accumulated POS Receivables into the Cash/Bank account. When triggered, <code>ReceiveSettlementUseCase</code> debits Cash and credits POS Receivables for all settled references atomically.
                    </p>
                    <div class="d-flex gap-4">
                        <div>
                            <span class="text-muted small">Pending Settlement:</span>
                            <span class="fw-bold text-primary fs-5 ms-1">@Model.PendingSettlements.Count invoices</span>
                        </div>
                        <div>
                            <span class="text-muted small">Total Batch Amount:</span>
                            <span class="fw-bold text-success fs-5 ms-1">&#8358;@Model.TotalPendingSettlementAmount.ToString("N2")</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                    <form method="post" asp-page-handler="ProcessSettlement">
                        <button type="submit" class="btn btn-success btn-lg shadow-sm w-100" @(Model.PendingSettlements.Count == 0 ? "disabled" : "")>
                            &#9889; Process Settlement Batch Now
                        </button>
                    </form>
                    @if (Model.PendingSettlements.Count == 0)
                    {
                        <span class="text-muted small d-block mt-1">&#10004; All captured invoices are fully settled</span>
                    }
                </div>
            </div>

            @if (Model.PendingSettlements.Count > 0)
            {
                <div class="mt-3 pt-3 border-top">
                    <h6 class="small fw-bold text-uppercase text-secondary mb-2">Invoices in this Batch</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle mb-0 bg-white">
                            <thead class="table-light">
                                <tr>
                                    <th>Invoice #</th>
                                    <th>Description</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.PendingSettlements)
                                {
                                    <tr>
                                        <td class="font-monospace fw-bold">@item.InvoiceId</td>
                                        <td>@item.Description</td>
                                        <td class="fw-bold">@item.Currency @item.Amount.ToString("N2")</td>
                                        <td><span class="badge bg-warning text-dark">&#9203; Awaiting Settlement</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Chart of Accounts & Balances -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-bold">&#127974; Chart of Accounts &amp; Current Balances</h5>
            <span class="text-secondary small">Real-time balances calculated from General Ledger</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Account Code</th>
                            <th>Account Title</th>
                            <th>Category</th>
                            <th>Normal Balance</th>
                            <th class="text-end">Total Debits (DR)</th>
                            <th class="text-end">Total Credits (CR)</th>
                            <th class="text-end">Net Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var acc in Model.AccountBalances)
                        {
                            <tr>
                                <td class="font-monospace fw-bold">#@acc.AccountId</td>
                                <td class="fw-bold">@acc.AccountName</td>
                                <td>
                                    <span class="badge @(acc.AccountType == "Asset" ? "bg-info text-dark" : "bg-primary")">
                                        @acc.AccountType
                                    </span>
                                </td>
                                <td><span class="text-secondary">@acc.NormalBalance</span></td>
                                <td class="text-end font-monospace text-muted">&#8358;@acc.TotalDebits.ToString("N2")</td>
                                <td class="text-end font-monospace text-muted">&#8358;@acc.TotalCredits.ToString("N2")</td>
                                <td class="text-end fw-bold font-monospace fs-6 text-success">
                                    &#8358;@acc.NetBalance.ToString("N2")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- General Ledger Audit Log -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-bold">&#128214; General Ledger Journal Entries</h5>
            <span class="badge bg-secondary">Total Entries: @Model.LedgerEntries.Count</span>
        </div>
        <div class="card-body p-0">
            @if (Model.LedgerEntries.Count == 0)
            {
                <div class="p-4 text-center text-muted">
                    No ledger entries recorded yet.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 15%;">Document</th>
                                <th style="width: 45%;">Entry Line Description / Account</th>
                                <th class="text-end" style="width: 20%;">Debit (DR)</th>
                                <th class="text-end" style="width: 20%;">Credit (CR)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in Model.LedgerEntries)
                            {
                                <tr class="table-secondary">
                                    <td colspan="4" class="fw-bold py-2">
                                        <span class="badge bg-dark me-2">@entry.DocumentType</span>
                                        Reference: <code>@entry.DocumentId</code> &bull; Total: @entry.Amount.Currency @entry.Amount.Value.ToString("N2")
                                    </td>
                                </tr>
                                @foreach (var sub in entry.Entries)
                                {
                                    var accountName = Model.AccountBalances.FirstOrDefault(a => a.AccountId == sub.AccountId)?.AccountName ?? $"Account #{sub.AccountId}";
                                    <tr>
                                        <td class="text-muted small ps-3">
                                            @sub.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@sub.Description</div>
                                            <div class="small text-secondary">&#127974; #@sub.AccountId: @accountName</div>
                                        </td>
                                        <td class="text-end font-monospace text-primary fw-bold">
                                            @(sub.EntryType == TransactionType.Debit ? $"{entry.Amount.Currency} {sub.Amount.Value:N2}" : "-")
                                        </td>
                                        <td class="text-end font-monospace text-success fw-bold">
                                            @(sub.EntryType == TransactionType.Credit ? $"{entry.Amount.Currency} {sub.Amount.Value:N2}" : "-")
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

