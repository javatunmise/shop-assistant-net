@page
@model shopassistantweb.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin / Settlement";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 fw-bold text-sa mb-0">Admin &mdash; Settlement &amp; General Ledger</h1>
        <p class="text-muted small mb-0">Reconcile processor batches, clear receivables to cash, audit GL journals &mdash; <code>ReceiveSettlementUseCase</code></p>
    </div>
    <a asp-page="/Index" class="btn btn-sa-outline btn-sm">← Dashboard</a>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-sa-success alert-dismissible fade show mb-3 py-2" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-sa-error alert-dismissible fade show mb-3 py-2" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Settlement Batch Bar -->
<div class="sa-card card accent-purple mb-4">
    <div class="card-body p-3">
        <div class="row align-items-center g-3">
            <div class="col-md-7">
                <div class="stat-label mb-1">Processor Bank Settlement Batch</div>
                <p class="text-muted small mb-2">
                    Clears POS Receivables into Cash/Bank. For each reference: DR Cash, CR POS Receivables. All writes are atomic via <code>TransactionScope</code>.
                </p>
                <div class="d-flex gap-4">
                    <div>
                        <span class="stat-label">Pending</span>
                        <span class="text-sa fw-bold fs-6 ms-1">@Model.PendingSettlements.Count invoices</span>
                    </div>
                    <div>
                        <span class="stat-label">Batch total</span>
                        <span class="fw-bold fs-6 ms-1">&#8358;@Model.TotalPendingSettlementAmount.ToString("N2")</span>
                    </div>
                    <div>
                        <span class="stat-label">Already settled</span>
                        <span class="fw-bold fs-6 ms-1">&#8358;@Model.TotalSettledAmount.ToString("N2")</span>
                    </div>
                </div>
            </div>
            <div class="col-md-5 text-md-end">
                <form method="post" asp-page-handler="ProcessSettlement">
                    <button type="submit" class="btn btn-sa px-4" @(Model.PendingSettlements.Count == 0 ? "disabled" : "")>
                        Process Settlement Batch
                    </button>
                </form>
                @if (Model.PendingSettlements.Count == 0)
                {
                    <div class="text-muted small mt-1">All paid invoices are already settled</div>
                }
            </div>
        </div>

        @if (Model.PendingSettlements.Count > 0)
        {
            <div class="mt-3 pt-3 border-top">
                <div class="stat-label mb-2">Invoices in this Batch</div>
                <div class="table-responsive">
                    <table class="table sa-table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Invoice #</th>
                                <th>Description</th>
                                <th>Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.PendingSettlements)
                            {
                                <tr>
                                    <td class="font-monospace small fw-bold">@item.InvoiceId</td>
                                    <td class="small">@item.Description</td>
                                    <td class="small fw-bold">@item.Currency @item.Amount.ToString("N2")</td>
                                    <td><span class="badge badge-pending small">Awaiting Settlement</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

<!-- Account Balances -->
<div class="sa-card card mb-4">
    <div class="card-header py-2 px-3 d-flex justify-content-between align-items-center">
        <span>Chart of Accounts &amp; Balances</span>
        <span class="text-muted small">Real-time from GL</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table sa-table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Account</th>
                        <th>Category</th>
                        <th>Normal</th>
                        <th class="text-end">Debits (DR)</th>
                        <th class="text-end">Credits (CR)</th>
                        <th class="text-end">Net Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var acc in Model.AccountBalances)
                    {
                        <tr>
                            <td class="font-monospace small">#@acc.AccountId</td>
                            <td class="fw-bold small">@acc.AccountName</td>
                            <td><span class="badge badge-settled small">@acc.AccountType</span></td>
                            <td class="small text-muted">@acc.NormalBalance</td>
                            <td class="text-end font-monospace small text-muted">&#8358;@acc.TotalDebits.ToString("N2")</td>
                            <td class="text-end font-monospace small text-muted">&#8358;@acc.TotalCredits.ToString("N2")</td>
                            <td class="text-end font-monospace fw-bold text-sa">&#8358;@acc.NetBalance.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- General Ledger Journal -->
<div class="sa-card card">
    <div class="card-header py-2 px-3 d-flex justify-content-between align-items-center">
        <span>General Ledger Journal Entries</span>
        <span class="badge badge-settled">@Model.LedgerEntries.Count entries</span>
    </div>
    <div class="card-body p-0">
        @if (Model.LedgerEntries.Count == 0)
        {
            <div class="text-center py-5 text-muted small">No ledger entries recorded yet.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table sa-table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width:160px">Document</th>
                            <th>Description / Account</th>
                            <th class="text-end" style="width:140px">Debit (DR)</th>
                            <th class="text-end" style="width:140px">Credit (CR)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.LedgerEntries)
                        {
                            <tr style="background:#f5f3fb;">
                                <td colspan="4" class="py-2 px-3">
                                    <span class="badge badge-settled me-2 small">@entry.DocumentType</span>
                                    <code class="small">@entry.DocumentId</code>
                                    <span class="text-muted ms-2 small">&bull; @entry.Amount.Currency @entry.Amount.Value.ToString("N2")</span>
                                </td>
                            </tr>
                            @foreach (var sub in entry.Entries)
                            {
                                var accountName = Model.AccountBalances.FirstOrDefault(a => a.AccountId == sub.AccountId)?.AccountName ?? $"Account #{sub.AccountId}";
                                <tr>
                                    <td class="text-muted small ps-4">@sub.Timestamp.ToString("MM-dd HH:mm:ss")</td>
                                    <td>
                                        <div class="small fw-semibold">@sub.Description</div>
                                        <div class="x-small text-muted" style="font-size:.75rem;">#@sub.AccountId &mdash; @accountName</div>
                                    </td>
                                    <td class="text-end font-monospace small fw-bold text-sa">
                                        @(sub.EntryType == TransactionType.Debit ? $"{entry.Amount.Currency} {sub.Amount.Value:N2}" : "—")
                                    </td>
                                    <td class="text-end font-monospace small fw-bold text-success">
                                        @(sub.EntryType == TransactionType.Credit ? $"{entry.Amount.Currency} {sub.Amount.Value:N2}" : "—")
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
