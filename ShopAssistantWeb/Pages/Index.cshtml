@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h4 fw-bold mb-0 text-sa">ShopAssistant Web</h1>
        <p class="text-muted mb-0 small">Point of Sale · Invoice Payment · General Ledger Settlement</p>
    </div>
    <span class="badge badge-settled px-3 py-2">System Online</span>
</div>

<!-- Stat Row -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-block">
            <div class="stat-label">Total Invoices</div>
            <div class="stat-value">@Model.TotalInvoices</div>
            <div class="stat-sub">
                <span class="text-success fw-bold">@Model.PaidInvoices Paid</span>
                &nbsp;&bull;&nbsp;
                <span style="color:#856404;" class="fw-bold">@Model.UnpaidInvoices Pending</span>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-block">
            <div class="stat-label">Sales Revenue</div>
            <div class="stat-value">&#8358;@Model.RevenueBalance.ToString("N2")</div>
            <div class="stat-sub">Credit-normal balance</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-block">
            <div class="stat-label">POS Receivables</div>
            <div class="stat-value text-sa">&#8358;@Model.ReceivablesBalance.ToString("N2")</div>
            <div class="stat-sub">Unsettled processor funds</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-block">
            <div class="stat-label">Cash / Bank</div>
            <div class="stat-value">&#8358;@Model.CashBalance.ToString("N2")</div>
            <div class="stat-sub">Settled bank liquidity</div>
        </div>
    </div>
</div>

<!-- Portal Cards -->
<div class="row g-4">
    <div class="col-md-6">
        <div class="sa-card card h-100 accent-purple">
            <div class="card-body p-4 d-flex flex-column">
                <div class="stat-label mb-1">Use Case 1</div>
                <h3 class="h5 fw-bold text-sa mb-2">Cashier POS Terminal</h3>
                <p class="text-muted small mb-4">
                    Issue customer invoices and capture instant POS payments. Runs <code>ReceivePaymentFromPOSUseCase</code> —
                    debits POS Receivables and credits Sales Revenue atomically.
                </p>
                <div class="mt-auto">
                    <a asp-page="/Cashier/Index" class="btn btn-sa w-100">Open Cashier Terminal &rarr;</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="sa-card card h-100 accent-purple">
            <div class="card-body p-4 d-flex flex-column">
                <div class="stat-label mb-1">Use Case 2</div>
                <h3 class="h5 fw-bold text-sa mb-2">Admin Settlement &amp; Ledger</h3>
                <p class="text-muted small mb-4">
                    Trigger end-of-day processor batch settlements, inspect the double-entry GL journal, and monitor live account balances.
                    Runs <code>ReceiveSettlementUseCase</code>.
                </p>
                <div class="mt-auto">
                    <a asp-page="/Admin/Index" class="btn btn-sa w-100">Open Admin Console &rarr;</a>
                </div>
            </div>
        </div>
    </div>
</div>
